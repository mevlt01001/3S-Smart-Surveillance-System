name: "yoloe_detector"
backend: "tensorrt"
max_batch_size: 8

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  },
  {
    name: "text_feats"
    data_type: TYPE_FP32
    dims: [ -1, 512 ]
  }
]

output [
  {
    name: "outputs"
    data_type: TYPE_FP32
    dims: [ -1, 8400 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
