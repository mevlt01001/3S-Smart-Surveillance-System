# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. ".env" git'e girmez.
#
# Dil modeli servisi (kural açıklamalarını çözümler, olay özetlerini yazar).
# Anahtar boş bırakılırsa sistem çalışır; yalnızca kurallar "Hazırlanamadı" görünür
# ve olaylar özetsiz kaydedilir.
EVREN_API_KEY=
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# EVREN_VLM_MODEL=qwen3-vl-30b

# Kamera, kural, ayar ve olay kayıtlarının tutulduğu dizin (varsayılan: WebInterface/backend)
# AEGIS_DATA_DIR=/var/lib/aegisvision
